# Ginode: demo scene. Edit me! Russian or English keywords both work.
# Углы в градусах. Касание экрана меняет цвет куба, тяга пальцем вращает его.

нода Нода3Д Мир

  нода Камера Камера
    позиция = вектор(0, 1.5, 4)
    вращение = вектор(-20, 0, 0)

  нода Свет Солнце
    вращение = вектор(-50, 30, 0)
    цвет = вектор(1, 0.95, 0.85)
    сила = 1.2

  нода Плоскость Пол
    позиция = вектор(0, -1.2, 0)
    масштаб = вектор(80, 1, 80)
    цвет = вектор(0.45, 0.47, 0.5)

  нода Куб Игрок
    цвет = вектор(0.9, 0.3, 0.2)
    скорость = 40

    старт
      печать("Игрок готов")

    кадр
      вращение.y += скорость * дт

    касание
      цвет = вектор(случайное(), случайное(), случайное())
      Шар.подпрыгнуть()

    тяга
      вращение.y += дх * 300
      вращение.x += ду * 300

  нода Сфера Шар
    цвет = вектор(0.2, 0.6, 0.9)
    время = 0
    скачок = 0

    функция подпрыгнуть()
      скачок = 1

    кадр
      время += дт
      скачок = макс(0, скачок - дт * 2)
      позиция = вектор(косинус(время * 60) * 2.2, 0.3 + скачок * 1.5, синус(время * 60) * 2.2)
